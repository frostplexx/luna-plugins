{
	"name": "@frostplexx/luna-plugins",
	"description": "TidaLuna plugins repo",
	"type": "module",
	"scripts": {
		"watch": "concurrently \"pnpm:build --watch\" pnpm:serve",
		"build": "rimraf ./dist && tsx esbuild.config.ts",
		"serve": "http-server ./dist -p 3000 -s --cors -c-1"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"concurrently": "^10.0.0",
		"http-server": "^14.1.1",
		"luna": "github:Inrixia/TidaLuna",
		"oby": "^15.1.2",
		"rimraf": "^6.1.2",
		"tsx": "^4.21.0",
		"typescript": "^7.0.0"
	}
}
